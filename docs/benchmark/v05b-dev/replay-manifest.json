 "policies": [
  {
   "id": "noop",
   "version": "1",
   "description": "never submits an action (agent.Noop)"
  },
  {
   "id": "llm",
   "version": "2",
   "description": "the LLM agent (agents/llm/llm_agent.py, llm-agent 2) in replay mode: the live smoke test's recorded decisions, each checked against its decision point and digests, with the memory and prompt rebuilt and checked against their recorded SHA-256; no model is called",
   "external": {
    "command": [
     "python3",
     "-I",
     "-B",
     "./agents/llm/llm_agent.py",
     "--replay",
     "./docs/benchmark/v05b-dev/llm-decisions.jsonl"
    ],
    "timeoutSeconds": 300,
    "files": [
     {
      "path": "./agents/llm/llm_agent.py",

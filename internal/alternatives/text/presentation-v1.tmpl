{{- range .Obligations}}
    - {{.Label}}: {{val .}}{{if .When}} · {{.When}}{{end}}{{if .Basis}} · {{.Basis}}{{end}}{{if .Derivation}} · derived: {{.Derivation}}{{end}}
{{- else}}
    - none listed
{{- end}}
  Reversibility: {{.Reversibility.Text}} · {{.Reversibility.Basis}}
